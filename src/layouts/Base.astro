---
// Gabarit commun à toutes les pages : en-tête, pied de page, polices et styles globaux.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'OrauX',
  description = "Planches d'oraux des concours, corrigées. MP · PSI · PC.",
} = Astro.props;
const fullTitle = title === 'OrauX' ? "OrauX · Planches d'oraux corrigées" : `${title} · OrauX`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">Orau<span>X</span></a>
        <p class="tagline">Planches d'oraux corrigées · MP · PSI · PC</p>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>OrauX · site en construction · {new Date().getFullYear()}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 2px solid var(--ink) }
  .bar { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 24px; padding-block: 18px 14px }
  .brand { font-family: var(--display); font-weight: 700; font-size: 1.75rem; letter-spacing: -0.02em; color: var(--ink); text-decoration: none }
  .brand span { color: var(--accent) }
  .tagline { margin: 0; color: var(--ink-soft); font-size: 0.95rem }
  main { min-height: 60vh }
  .site-footer { border-top: 1px solid var(--rule); margin-top: 64px; color: var(--ink-soft); font-family: var(--mono); font-size: 0.78rem }
  .site-footer p { margin: 0; padding-block: 20px 28px }
</style>
