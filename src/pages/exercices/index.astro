---
// Tous les exercices, rangés par concours. Les filtres (filière, chapitre) arrivent en semaine 3.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CarteExercice from '../../components/CarteExercice.astro';
import { banques } from '../../data/banques';

const exercices = (await getCollection('exercices')).sort((a, b) => a.data.titre.localeCompare(b.data.titre, 'fr'));
---

<Base title="Exercices">
  <section class="wrap section">
    <div class="section-head">
      <h1>Les <em class="marker">exercices</em></h1>
      <p class="hand note">Les vraies planches arrivent bientôt !</p>
    </div>
    {banques.map((banque) => {
      const liste = exercices.filter((exo) => exo.data.banque === banque.nom);
      return (
        <section class={`banque ${banque.cle}`} aria-labelledby={`b-${banque.slug}`}>
          <h2 id={`b-${banque.slug}`}><a href={`/concours/${banque.slug}`}>{banque.nom} →</a></h2>
          {liste.length > 0 ? (
            <ul class="liste">
              {liste.map((exo) => <li><CarteExercice exo={exo} /></li>)}
            </ul>
          ) : (
            <p class="hand vide">Bientôt !</p>
          )}
        </section>
      );
    })}
    <p class="proposer">Vous avez passé un oral ? <a href="/proposer">Proposez votre exercice</a> avec sa correction.</p>
  </section>
</Base>

<style>
  .section { margin-top: 56px }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 22px; margin-bottom: 10px }
  h1 { font-family: var(--display); font-weight: 800; font-size: clamp(2.2rem, 5vw, 3.2rem); line-height: 1.05; letter-spacing: -0.03em; margin: 0 }
  h1 em { font-style: italic; font-weight: 600 }
  .note { margin: 0; color: var(--red); font-size: 1.6rem; transform: rotate(-3deg) }

  .banque { --c: var(--bic); margin-top: 40px }
  .banque.mines { --c: var(--mines) }
  .banque.centrale { --c: var(--centrale) }
  .banque.xens { --c: var(--xens) }
  h2 { font-family: var(--display); font-weight: 800; font-size: 1.8rem; letter-spacing: -0.02em; margin: 0 0 18px }
  h2 a { color: var(--ink); text-decoration: underline 4px var(--c); text-underline-offset: 6px }
  .liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)) }
  .vide { margin: 0; color: var(--ink-soft); font-size: 1.4rem }
  .proposer { margin-top: 48px; font-weight: 500 }
</style>
