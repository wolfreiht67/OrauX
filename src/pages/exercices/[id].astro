---
// Une page par exercice. Astro crée une page pour chaque fichier de src/content/exercices/.
// Les crochets dans le nom du fichier ([id]) veulent dire : « cette partie de l'adresse change ».
import 'katex/dist/katex.min.css';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const exercices = await getCollection('exercices');
  return exercices.map((exo) => ({ params: { id: exo.id }, props: { exo } }));
}

const { exo } = Astro.props;
const { Content } = await render(exo);
const d = exo.data;
const couleur = { 'Mines-Ponts': 'mines', 'Centrale-Supélec': 'centrale', 'X-ENS': 'xens' }[d.banque];
---

<Base title={d.titre} description={`${d.banque} · ${d.filiere} · ${d.chapitre}`}>
  <div class="seyes page">
    <div class="wrap colonne">
      <p class="retour"><a href="/exercices">← Tous les exercices</a></p>

      <div class="chrono" role="timer" aria-label="Chronomètre de préparation">
        <span class="rec" aria-hidden="true"></span>Préparation
        <b id="chrono" data-minutes={d.duree}>{String(d.duree).padStart(2, '0')}:00</b>
        <button type="button" id="chrono-bouton">Lancer</button>
      </div>

      <article class={`sheet planche ${couleur}`}>
        {d.exemple && <span class="exemple">Exemple écrit pour la maquette</span>}
        <p class="planche-meta">
          <span class="dot" aria-hidden="true"></span>
          {d.banque} · {d.filiere} · {d.matiere}{d.annee && ` · ${d.annee}`}
        </p>
        <h1>{d.titre}</h1>
        <p class="chapitre">{d.chapitre}</p>
        <div class="contenu">
          <Content />
        </div>
        {(d.origine || d.auteur) && (
          <p class="origine">
            {d.origine}{d.origine && d.auteur && ' · '}{d.auteur && `Proposé par ${d.auteur}`}
          </p>
        )}
      </article>
    </div>
  </div>
</Base>

<script>
  // Chrono de préparation : le bouton lance ou met en pause le décompte.
  const el = document.getElementById('chrono');
  const bouton = document.getElementById('chrono-bouton');
  if (el && bouton) {
    let s = Number(el.dataset.minutes) * 60;
    let minuteur: ReturnType<typeof setInterval> | undefined;
    const afficher = () => {
      el.textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    };
    bouton.addEventListener('click', () => {
      if (minuteur) {
        clearInterval(minuteur);
        minuteur = undefined;
        bouton.textContent = 'Reprendre';
      } else {
        minuteur = setInterval(() => {
          if (s > 0) s -= 1;
          afficher();
          if (s === 0) { clearInterval(minuteur); bouton.textContent = 'Terminé'; }
        }, 1000);
        bouton.textContent = 'Pause';
      }
    });
  }
</script>

<style>
  .page { padding-block: 32px 72px; border-bottom: 2px solid var(--ink) }
  .colonne { max-width: 820px }
  .retour { margin: 0 0 22px; font-weight: 600 }

  .chrono { display: inline-flex; align-items: center; gap: 8px; margin-bottom: -10px; position: relative; z-index: 2; background: var(--ink); color: var(--paper); font-size: 0.85rem; font-weight: 600; padding: 6px 8px 6px 14px; border-radius: 999px; transform: rotate(-2deg) }
  .chrono b { font-size: 1.05rem; font-variant-numeric: tabular-nums }
  .chrono button { font: inherit; font-size: 0.8rem; cursor: pointer; color: var(--ink); background: var(--paper); border: 0; border-radius: 999px; padding: 3px 12px }
  .rec { width: 8px; height: 8px; border-radius: 50%; background: #ff5a5a }

  /* La copie : marge rouge à gauche, comme une vraie feuille. */
  .planche { position: relative; padding: 38px 32px 40px 70px; font-size: 1.05rem;
    background-image: linear-gradient(90deg, transparent 46px, #f2a3a3 46px, #f2a3a3 48px, transparent 48px) }
  @media (max-width: 600px) {
    .planche { padding: 40px 18px 32px 34px; background-image: linear-gradient(90deg, transparent 22px, #f2a3a3 22px, #f2a3a3 24px, transparent 24px) }
  }
  .planche.mines { --c: #e8871e }
  .planche.centrale { --c: #d6336c }
  .planche.xens { --c: #1d4ed8 }
  .planche-meta { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-soft) }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--c) }
  h1 { font-family: var(--display); font-weight: 800; font-size: clamp(1.9rem, 5vw, 2.6rem); line-height: 1.1; letter-spacing: -0.02em; margin: 8px 0 2px }
  .chapitre { margin: 0 0 22px; font-family: var(--display); font-style: italic; color: var(--ink-soft) }
  .exemple { position: absolute; top: 12px; right: 14px; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); border: 1px dashed currentColor; border-radius: 3px; padding: 1px 6px }
  .origine { margin: 28px 0 0; font-size: 0.85rem; color: var(--ink-soft) }

  /* Les formules longues défilent au lieu de déborder sur téléphone. */
  .contenu :global(.katex-display) { overflow-x: auto; overflow-y: hidden; padding-block: 4px }

  /* L'indication (post-it) et la correction (au rouge), fermées par défaut. */
  .contenu :global(details.partie) { margin-top: 26px }
  .contenu :global(summary) { cursor: pointer; font-family: var(--hand); font-weight: 700; font-size: 1.6rem; line-height: 1.2 }
  .contenu :global(details.indication) { max-width: 520px; padding: 12px 20px 14px; color: #2b2410; background: var(--postit); box-shadow: 0 12px 22px -12px rgba(60, 45, 0, 0.55); transform: rotate(-1deg) }
  .contenu :global(details.correction) { padding-left: 18px; border-left: 4px solid var(--red) }
  .contenu :global(details.correction summary) { color: var(--red) }
  .contenu :global(details > :last-child) { margin-bottom: 0 }
</style>
