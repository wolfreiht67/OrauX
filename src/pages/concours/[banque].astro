---
// Une page par concours : /concours/mines-ponts, /concours/centrale-supelec, /concours/x-ens.
// Ses exercices sont rangés par filière.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CarteExercice from '../../components/CarteExercice.astro';
import { banques } from '../../data/banques';

export function getStaticPaths() {
  return banques.map((banque) => ({ params: { banque: banque.slug }, props: { banque } }));
}

const { banque } = Astro.props;
const exercices = (await getCollection('exercices', (exo) => exo.data.banque === banque.nom))
  .sort((a, b) => a.data.titre.localeCompare(b.data.titre, 'fr'));
---

<Base title={banque.nom} description={`Exercices d'oral ${banque.nom} corrigés, MP · PSI · PC.`}>
  <header class={`bandeau ${banque.cle}`}>
    <div class="logos" aria-hidden="true">
      {banque.logos.map((l) => (
        <span class="filigrane" style={`--logo: url(${l.src}); aspect-ratio: ${l.ratio}; ${l.pos}`} />
      ))}
    </div>
    <div class="wrap">
      <p class="retour"><a href="/#banques">← Les concours</a></p>
      <p class="kicker">Banque</p>
      <h1>{banque.nom}</h1>
      <p class="compte">{exercices.length} exercice{exercices.length > 1 && 's'}</p>
    </div>
  </header>

  <div class="wrap">
    {banque.filieres.map((filiere) => {
      const liste = exercices.filter((exo) => exo.data.filiere === filiere);
      return (
        <section class="filiere" aria-labelledby={`f-${filiere}`}>
          <h2 id={`f-${filiere}`}><span class="pastille">{filiere}</span></h2>
          {liste.length > 0 ? (
            <ul class="liste">
              {liste.map((exo) => <li><CarteExercice exo={exo} /></li>)}
            </ul>
          ) : (
            <p class="hand vide">Pas encore d'exercice en {filiere}… bientôt !</p>
          )}
        </section>
      );
    })}
    <p class="proposer">Vous avez passé l'oral {banque.nom} ? <a href="/proposer">Proposez votre exercice</a> avec sa correction.</p>
  </div>
</Base>

<style>
  .bandeau { --c: var(--bic); position: relative; overflow: hidden; padding-block: 28px 40px; border-bottom: 2px solid var(--ink); background: color-mix(in srgb, var(--c) 13%, var(--paper)) }
  .bandeau.mines { --c: var(--mines) }
  .bandeau.centrale { --c: var(--centrale) }
  .bandeau.xens { --c: var(--xens) }
  .bandeau .wrap { position: relative }
  /* Les logos gardent le placement réglé pour les tuiles de l'accueil : on leur donne une boîte de la même taille, à droite. */
  .logos { position: absolute; top: 0; right: 0; width: min(380px, 70%); height: 100%; pointer-events: none }
  .filigrane { position: absolute; background: var(--c); opacity: 0.25; transform: rotate(var(--r, 0deg));
    -webkit-mask: var(--logo) no-repeat center / contain; mask: var(--logo) no-repeat center / contain }
  .retour { margin: 0 0 18px; font-weight: 600 }
  .kicker { margin: 0; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft) }
  h1 { font-family: var(--display); font-weight: 800; font-size: clamp(2.6rem, 7vw, 4.2rem); line-height: 1; letter-spacing: -0.03em; margin: 4px 0 10px }
  .compte { margin: 0; font-weight: 600 }

  .filiere { margin-top: 48px }
  h2 { margin: 0 0 20px }
  .pastille { display: inline-block; font-family: var(--body); font-weight: 700; font-size: 1.1rem; padding: 3px 16px; border: 2px solid var(--ink); border-radius: 999px; background: var(--paper) }
  .liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)) }
  .vide { margin: 0; color: var(--ink-soft); font-size: 1.4rem }
  .proposer { margin-top: 56px; font-weight: 500 }
</style>
