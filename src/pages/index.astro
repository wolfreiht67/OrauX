---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { banques } from '../data/banques';

// Nombre d'exercices par banque, affiché sur chaque tuile.
const exercices = await getCollection('exercices');
const nombre = (nom: string) => exercices.filter((exo) => exo.data.banque === nom).length;

// Chapitres de maths uniquement.
const chapitres = [
  'Réduction des endomorphismes', 'Séries entières', 'Intégrales à paramètre', 'Probabilités',
  'Espaces euclidiens', 'Équations différentielles', 'Topologie des evn', 'Suites et séries de fonctions',
  'Calcul différentiel', 'Polynômes', 'Intégration sur un intervalle', 'Endomorphismes autoadjoints',
];

const temps = [
  { cle: 'enonce', objet: 'sheet', titre: 'Énoncé', texte: "La planche telle qu'elle tombe à l'oral, avec le concours, la filière, l'année et la durée de préparation." },
  { cle: 'indic', objet: 'postit', titre: 'Indication', texte: 'Un coup de pouce, caché par défaut, pour se débloquer sans tout dévoiler.' },
  { cle: 'correction', objet: 'sheet', titre: 'Correction', texte: "Rédigée au propre et relue, à ouvrir une fois qu'on a vraiment cherché." },
];
---

<Base>
  <section class="hero seyes">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="hand kicker">« Vous avez 30 minutes de préparation. »</p>
        <h1>
          Les planches d'oraux de prépa,
          <span class="circled">corrigées<svg viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M14 44 C 10 18, 70 6, 120 8 C 172 10, 196 26, 190 46 C 184 66, 120 74, 76 70 C 30 66, 4 56, 12 34 C 18 20, 46 12, 66 10" /></svg></span>.
        </h1>
        <p class="lead">
          Mines-Ponts, Centrale-Supélec, X-ENS. Des exercices d'oral classés par filière et par chapitre, avec une
          <span class="marker">indication</span> pour se débloquer et une correction rédigée au propre.
        </p>
        <div class="cta">
          <a class="stamp" href="/exercices">Voir les exercices</a>
          <a class="see" href="#banques">Voir les banques ↓</a>
        </div>
      </div>

      <div class="desk">
        <div class="chrono" role="timer" aria-label="Chronomètre de préparation">
          <span class="rec" aria-hidden="true"></span>Préparation <b id="chrono">30:00</b>
        </div>
        <article class="sheet planche">
          <span class="exemple">Exemple</span>
          <p class="planche-meta"><span class="dot" aria-hidden="true"></span>Mines-Ponts · MP · Maths</p>
          <h2>Signe du déterminant</h2>
          <p>Soit A ∈ M<sub>n</sub>(ℝ) telle que A³ = A + I<sub>n</sub>.<br />Montrer que det A &gt; 0.</p>
          <p class="hand red-note">α &gt; 1 et |β|² = 1/α donc det A &gt; 0 ✓</p>
        </article>
        <aside class="postit indication">
          <span class="hand">Indication</span>
          <p class="hand">Regarde les racines de X³ − X − 1…</p>
        </aside>
      </div>
    </div>
  </section>

  <div class="ruban" aria-hidden="true">
    <div class="ruban-track">
      {[...chapitres, ...chapitres].map((c) => <span>{c}<i>✶</i></span>)}
    </div>
  </div>

  <section class="wrap section" id="banques" aria-labelledby="banques-titre">
    <div class="section-head">
      <h2 id="banques-titre">Trois banques, <em class="marker">trois filières</em></h2>
      <p class="hand note">MP, PSI et PC partout !</p>
    </div>
    <ul class="banques">
      {banques.map((b) => (
        <li>
          <a class={`banque ${b.cle}`} href={`/concours/${b.slug}`}>
            {b.logos.map((l) => (
              <span class="filigrane" aria-hidden="true" style={`--logo: url(${l.src}); aspect-ratio: ${l.ratio}; ${l.pos}`} />
            ))}
            <p class="banque-kicker">Banque</p>
            <h3>{b.nom}</h3>
            <p class="voir">{nombre(b.nom)} exercice{nombre(b.nom) > 1 && 's'} →</p>
            <ul class="filieres" aria-label="Filières">
              {b.filieres.map((f) => <li>{f}</li>)}
            </ul>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="temps-titre">
    <div class="section-head">
      <h2 id="temps-titre">Une planche, <em class="marker">trois temps</em></h2>
    </div>
    <ol class="temps">
      {temps.map((t, i) => (
        <li class={`temps-item ${t.objet} ${t.cle}`}>
          <span class="num" aria-hidden="true">{i + 1}.</span>
          <h3>{t.titre}</h3>
          <p>{t.texte}</p>
          {t.cle === 'correction' && <span class="hand annot" aria-hidden="true">Rédigé et relu ✓</span>}
        </li>
      ))}
    </ol>
  </section>
</Base>

<script>
  // Chrono de préparation : décompte de 30:00, puis recommence.
  const el = document.getElementById('chrono');
  if (el) {
    let s = 30 * 60;
    setInterval(() => {
      s = s > 0 ? s - 1 : 30 * 60;
      el.textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    }, 1000);
  }
</script>

<style>
  /* ---------- Accroche ---------- */
  .hero { border-bottom: 2px solid var(--ink); padding-block: 52px 88px }
  .hero-grid { display: grid; gap: 48px; align-items: center }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.15fr 1fr } }

  .kicker { display: inline-block; margin: 0 0 10px; color: var(--bic); font-size: 1.7rem; line-height: 1.1; transform: rotate(-2deg) }
  h1 { font-family: var(--display); font-weight: 800; font-size: clamp(2.5rem, 7vw, 4.7rem); line-height: 1.02; letter-spacing: -0.035em; margin: 0; text-wrap: balance }
  .circled { position: relative; display: inline-block; margin-left: 0.12em; font-style: italic; font-weight: 700 }
  .circled svg { position: absolute; left: -6%; top: -12%; width: 112%; height: 130%; overflow: visible; pointer-events: none }
  .circled path { fill: none; stroke: var(--red); stroke-width: 3.2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0 }
  .lead { font-size: 1.15rem; color: var(--ink-soft); max-width: 34em; margin: 26px 0 0 }

  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 32px }
  .stamp { display: inline-block; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; color: var(--red); border: 2.5px solid var(--red); border-radius: 6px; padding: 8px 14px; transform: rotate(-3deg); background: color-mix(in srgb, var(--paper) 80%, transparent) }
  .see { font-weight: 600; color: var(--ink); text-decoration: underline wavy var(--red); text-underline-offset: 6px }

  /* La table : la copie, le post-it et le chrono. */
  .desk { position: relative; display: flex; flex-direction: column; padding-top: 18px; max-width: 470px; width: 100%; justify-self: center }
  .planche { position: relative; padding: 30px 26px 52px 58px; transform: rotate(-2deg);
    background-image: linear-gradient(90deg, transparent 40px, #f2a3a3 40px, #f2a3a3 42px, transparent 42px) }
  .planche h2 { font-family: var(--display); font-weight: 700; font-size: 1.65rem; line-height: 1.15; margin: 6px 0 10px }
  .planche p { margin: 0 }
  .planche-meta { display: flex; align-items: center; gap: 8px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-soft) }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: #e8871e }
  .red-note { margin-top: 14px !important; color: var(--red); font-size: 1.5rem; line-height: 1.15; transform: rotate(-1.5deg) }
  .exemple { position: absolute; top: 12px; right: 14px; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); border: 1px dashed currentColor; border-radius: 3px; padding: 1px 6px }

  .indication { align-self: flex-end; width: min(210px, 62%); margin-top: -40px; margin-right: -6px; padding: 14px 16px 18px; transform: rotate(4deg); position: relative }
  .indication span { display: block; font-size: 1.15rem; text-decoration: underline }
  .indication p { margin: 4px 0 0; font-size: 1.4rem; line-height: 1.15 }

  .chrono { position: absolute; top: 0; left: -8px; z-index: 2; display: flex; align-items: center; gap: 8px; background: var(--ink); color: var(--paper); font-size: 0.8rem; font-weight: 600; padding: 6px 13px; border-radius: 999px; transform: rotate(-4deg) }
  .chrono b { font-size: 1rem; font-variant-numeric: tabular-nums }
  .rec { width: 8px; height: 8px; border-radius: 50%; background: #ff5a5a }

  /* ---------- Ruban des chapitres ---------- */
  .ruban { position: relative; z-index: 1; width: calc(100% + 80px); margin: -22px 0 0 -40px; overflow: hidden; background: var(--ink); color: var(--paper); padding-block: 14px; transform: rotate(-1.5deg) }
  .ruban-track { display: flex; width: max-content }
  .ruban span { display: flex; align-items: center; gap: 30px; padding-right: 30px; white-space: nowrap; font-family: var(--display); font-style: italic; font-size: 1.35rem }
  .ruban i { font-style: normal; color: var(--marker) }

  /* ---------- Sections ---------- */
  .section { margin-top: 96px }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 22px; margin-bottom: 34px }
  .section-head h2 { font-family: var(--display); font-weight: 800; font-size: clamp(2rem, 4.6vw, 3.1rem); line-height: 1.05; letter-spacing: -0.03em; margin: 0 }
  .section-head em { font-style: italic; font-weight: 600 }
  .note { margin: 0; color: var(--red); font-size: 1.7rem; transform: rotate(-3deg) }

  /* Les banques : tuiles colorées, filigrane de l'école en fond. */
  .banques { list-style: none; margin: 0; padding: 0; display: grid; gap: 26px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)) }
  .banque { --c: var(--bic); position: relative; overflow: hidden; display: flex; flex-direction: column; height: 100%; min-height: 240px; color: var(--ink); text-decoration: none; padding: 22px 24px 26px; border: 2px solid var(--ink); border-radius: 14px; background: color-mix(in srgb, var(--c) 13%, var(--paper)); box-shadow: 6px 6px 0 var(--c) }
  .banque.mines { --c: var(--mines) }
  .banque.centrale { --c: var(--centrale) }
  .banque.xens { --c: var(--xens) }
  .banque > :not(.filigrane) { position: relative }
  .filigrane { position: absolute; background: var(--c); opacity: 0.3; pointer-events: none; transform: rotate(var(--r, 0deg));
    -webkit-mask: var(--logo) no-repeat center / contain; mask: var(--logo) no-repeat center / contain }
  .banque-kicker { margin: 0; font-size: 0.76rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft) }
  .banque h3 { font-family: var(--display); font-weight: 800; font-size: 2rem; line-height: 1.05; letter-spacing: -0.02em; margin: 4px 0 auto }
  .voir { margin: 6px 0 0; font-weight: 600; text-decoration: underline wavy var(--c); text-underline-offset: 5px }
  .filieres { list-style: none; display: flex; gap: 8px; padding: 0; margin: 30px 0 0 }
  .filieres li { font-weight: 700; font-size: 0.9rem; padding: 3px 12px; border: 2px solid var(--ink); border-radius: 999px; background: var(--paper) }

  /* Les trois temps : la copie, le post-it, la copie corrigée. */
  .temps { list-style: none; margin: 0; padding: 0; display: grid; gap: 36px 28px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); align-items: start }
  .temps-item { position: relative; padding: 30px 24px 28px }
  .temps-item h3 { font-family: var(--display); font-weight: 700; font-size: 1.55rem; margin: 0 0 6px }
  .temps-item p { margin: 0; color: var(--ink-soft) }
  .num { position: absolute; top: -26px; left: -8px; font-family: var(--hand); font-weight: 700; font-size: 3.2rem; line-height: 1; color: #e03131; transform: rotate(-8deg) }
  .enonce { transform: rotate(-1.2deg) }
  .indic { transform: rotate(1.5deg) }
  .indic h3 { color: #2b2410 }
  .indic p { color: #4a4020 }
  .correction { transform: rotate(-0.6deg); border-left: 4px solid #e03131 }
  .annot { display: inline-block; margin-top: 12px; color: #e03131; font-size: 1.4rem; transform: rotate(-3deg) }

  /* ---------- Mouvements ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .circled path { stroke-dashoffset: 1; animation: trace 0.9s 0.5s ease-out forwards }
    .planche { animation: poser 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.2) both }
    .indication { animation: coller 0.6s 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.3) both }
    .rec { animation: pulse 1.2s ease-in-out infinite }
    .ruban-track { animation: defile 60s linear infinite }
    .banque { transition: transform 0.2s ease, box-shadow 0.2s ease }
    .banque:hover { transform: translate(-3px, -3px) rotate(-0.6deg); box-shadow: 10px 10px 0 var(--c) }
    .temps-item { transition: transform 0.2s ease }
    .temps-item:hover { transform: rotate(0deg) translateY(-4px) }
  }
  @keyframes trace { to { stroke-dashoffset: 0 } }
  @keyframes poser { from { opacity: 0; transform: translateY(24px) rotate(-7deg) } }
  @keyframes coller { from { opacity: 0; transform: translateY(-18px) rotate(14deg) scale(1.08) } }
  @keyframes pulse { 50% { opacity: 0.25 } }
  @keyframes defile { to { transform: translateX(-50%) } }
</style>
