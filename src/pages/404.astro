---
// La page affichée quand une adresse n'existe pas.
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable">
  <div class="seyes page">
    <div class="wrap">
      <article class="sheet copie">
        <p class="note hand" aria-hidden="true">0/20</p>
        <h1>Copie blanche.</h1>
        <p>Cette page n'existe pas (ou plus). Le correcteur n'a rien trouvé à noter.</p>
        <p class="hand rouge">Revoir le cours et recommencer.</p>
        <div class="liens">
          <a class="tampon plein" href="/">Retour à l'accueil</a>
          <a class="vague" href="/exercices">Voir les planches</a>
        </div>
      </article>
    </div>
  </div>
</Base>

<style>
  .page { padding-block: 72px 96px; border-bottom: 2px solid var(--ink) }
  .copie { position: relative; max-width: 560px; margin: 0 auto; padding: 40px 32px 34px 64px; transform: rotate(-1.5deg);
    background-image: linear-gradient(90deg, transparent 40px, #f2a3a3 40px, #f2a3a3 42px, transparent 42px) }
  h1 { font-family: var(--display); font-weight: 800; font-size: clamp(2.2rem, 6vw, 3rem); margin: 0 0 10px; letter-spacing: -0.02em }
  .note { position: absolute; top: -26px; right: 18px; margin: 0; color: var(--red); font-size: 4rem; line-height: 1; transform: rotate(-10deg) }
  .rouge { color: var(--red); font-size: 1.6rem; margin: 12px 0 0 }
  .liens { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 26px; margin-top: 26px }
</style>
